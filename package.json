{
  "name": "wyrdloom",
  "version": "0.5.0",
  "description": "Single-player isometric action-RPG. Web + native (Tauri). MIT-licensed source, CC0/CC-BY/OFL assets only.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint src tests tools --max-warnings 0",
    "format": "prettier --write src tests tools",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "check:licenses": "bun tools/check_licenses.ts",
    "sync:version": "bun tools/sync_version.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.1.1",
    "howler": "^2.2.4",
    "idb": "^8.0.0",
    "lit": "^3",
    "pixi.js": "^8.6.5",
    "seedrandom": "^3.0.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@tauri-apps/cli": "^2.1.0",
    "@types/howler": "^2.2.12",
    "@types/node": "^22.10.2",
    "@types/seedrandom": "^3.0.8",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
