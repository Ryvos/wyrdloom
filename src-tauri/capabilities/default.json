{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "WYRDLOOM capability allow-list. Per BUILD_PROMPT §2.5: fs (scoped to $APPDATA/wyrdloom/saves), window controls, dialog only. http:*, shell:*, process:* are FORBIDDEN — adding any requires an ADR in docs/adr/.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "core:window:allow-set-fullscreen",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "dialog:allow-message",
    {
      "identifier": "fs:allow-read-file",
      "allow": [{ "path": "$APPDATA/wyrdloom/saves/*" }]
    },
    {
      "identifier": "fs:allow-write-file",
      "allow": [{ "path": "$APPDATA/wyrdloom/saves/*" }]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [{ "path": "$APPDATA/wyrdloom/saves" }]
    },
    {
      "identifier": "fs:allow-read-dir",
      "allow": [{ "path": "$APPDATA/wyrdloom/saves" }]
    },
    {
      "identifier": "fs:allow-remove",
      "allow": [{ "path": "$APPDATA/wyrdloom/saves/*" }]
    }
  ]
}
